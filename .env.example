# Copy this file to .env and fill in your keys
# .env is gitignored — never commit real keys

ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here     # optional — only needed for web search agents
OFFICE_USER=admin                # dashboard login username (default: admin)
OFFICE_PASS=                     # dashboard login password — REQUIRED. If empty, the server generates a random one at startup and prints it.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/agent-complete  # optional — n8n integration
GITHUB_TOKEN=your_github_pat_here  # optional — push code + open PRs after agents complete
GITHUB_USERNAME=your_github_username  # optional — required if GITHUB_TOKEN is set
LINEAR_API_KEY=lin_api_your_key_here  # optional — create Linear issues per task at kickoff
LINEAR_TEAM_ID=your_team_id_here      # optional — required if LINEAR_API_KEY is set
LINEAR_WEBHOOK_SECRET=your_secret_here  # optional — verify Linear webhook signatures
JIRA_WEBHOOK_SECRET=your_secret_here    # optional — verify Jira webhook signatures (not used by Jira by default)
WEBHOOK_TRIGGER_LABEL=ai-office         # optional — only trigger on issues with this label (default: ai-office)
NOTION_API_KEY=secret_your_key_here     # optional — write project summary to Notion after agents complete
NOTION_DATABASE_ID=your_database_id    # optional — required if NOTION_API_KEY is set
PROJECT_BUDGET_USD=                     # optional — per-project spend ceiling in USD (e.g. 25). Project auto-pauses when exceeded. 0 or blank disables.
