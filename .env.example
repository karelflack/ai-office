# Copy this file to .env and fill in your keys
# .env is gitignored — never commit real keys

ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here     # optional — only needed for web search agents
N8N_WEBHOOK_URL=http://localhost:5678/webhook/agent-complete  # optional — n8n integration
GITHUB_TOKEN=your_github_pat_here  # optional — push code + open PRs after agents complete
GITHUB_USERNAME=your_github_username  # optional — required if GITHUB_TOKEN is set
