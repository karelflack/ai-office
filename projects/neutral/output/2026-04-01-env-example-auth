# .env.example — URL Shortener with Auth
# Copy to .env and fill in all values before running locally.
# Never commit .env to version control.

# PostgreSQL
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=changeme
POSTGRES_DB=urlshortener

# Application
BASE_URL=http://localhost:8000

# Logging: debug | info | warning | error
LOG_LEVEL=info

# Optional: override Redis URL (defaults to redis://redis:6379/0 inside Docker)
# REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-64-hex-chars-from-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting for auth endpoints (slowapi format: count/period)
# Supported periods: second, minute, hour, day
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_AUTH_REGISTER=5/minute
