# Dockerfile — md2html CLI
# Place at: projects/neutral/output/md2html/Dockerfile

# ── Builder stage ─────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build tooling
RUN pip install --no-cache-dir hatchling

# Copy only the files needed to build the wheel
COPY pyproject.toml README.md ./
COPY md2html/ ./md2html/

# Build the wheel (no watch extra — keep base image small)
RUN pip wheel --no-cache-dir --wheel-dir /wheels .

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Install the pre-built wheel (no build tools in runtime layer)
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels md2html \
    && rm -rf /wheels

# Default entrypoint — users bind-mount their markdown files
ENTRYPOINT ["md2html"]
CMD ["--help"]
