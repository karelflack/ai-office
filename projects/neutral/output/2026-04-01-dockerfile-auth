# Dockerfile — URL Shortener with Auth
#
# No changes required to system packages.
# python-jose[cryptography] and passlib[bcrypt] both build fine with gcc + libpq-dev
# already present in the builder stage from the original Dockerfile.
#
# This file is identical to the original except the CMD uses --workers 2
# so rate-limit state is shared via Redis, not in-process memory.
#
# IMPORTANT: if you switch from slowapi (Redis-backed limiter) to an in-process
# limiter, single-worker mode is required, or counts will be per-replica.

FROM python:3.12-slim AS builder

WORKDIR /app

# gcc: needed for cffi (cryptography dep of python-jose)
# libffi-dev: also needed for cffi on some python-slim variants
# libpq-dev: needed for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.12-slim

WORKDIR /app

# libpq5: runtime shared lib for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY . .

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

EXPOSE 8000

# 2 workers: keeps rate-limit Redis keys meaningful across concurrent requests.
# Scale horizontally via Railway replicas rather than increasing workers further.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
